#!/usr/bin/env bash
set -euo pipefail

VAULT="${KAMAL_1PASSWORD_VAULT:-lesvendredis.casa}"

need_op() {
  command -v op >/dev/null || {
    echo "1Password CLI is missing. Install it first: brew install 1password-cli"
    exit 1
  }

  op whoami >/dev/null 2>&1 || {
    echo "1Password CLI is not signed in."
    echo "Open 1Password, unlock it, then enable Settings > Developer > Integrate with 1Password CLI."
    exit 1
  }
}

ensure_vault() {
  if ! op vault get "$VAULT" >/dev/null 2>&1; then
    op vault create "$VAULT" --icon cabin >/dev/null
    echo "created vault: $VAULT"
  else
    echo "vault exists: $VAULT"
  fi
}

ensure_item() {
  local title="$1"
  shift

  if op item get "$title" --vault "$VAULT" >/dev/null 2>&1; then
    echo "item exists: $title"
  else
    op item create --category=secure-note --vault "$VAULT" --title "$title" "$@" >/dev/null
    echo "created item: $title"
  fi
}

need_op
ensure_vault

ensure_item "common" \
  'KAMAL_REGISTRY_PASSWORD[password]=' \
  'RAILS_MASTER_KEY[password]='

ensure_item "production" \
  'DATABASE_URL[password]=' \
  'RESEND_API_KEY[password]=' \
  'SECRET_KEY_BASE[password]='

ensure_item "staging" \
  'DATABASE_URL[password]=' \
  'RESEND_API_KEY[password]=' \
  'SECRET_KEY_BASE[password]='

echo "done"
echo "Fill the empty fields in 1Password vault: $VAULT"
