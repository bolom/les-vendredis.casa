<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Les Vendredis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Les Vendredis">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <% if (ga_measurement_id = ENV["GA_MEASUREMENT_ID"]).present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ga_measurement_id %>" data-lv-ga-script></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function(){dataLayer.push(arguments);};
        if (!window.__lesVendredisGaConfigured) {
          window.__lesVendredisGaConfigured = true;
          gtag("js", new Date());
          gtag("config", "<%= ga_measurement_id %>");
        }
        window.LesVendredisAnalytics = {
          track: function(eventName, params) {
            var allowedEvents = ["start_inquiry", "submit_inquiry", "inquiry_success"];
            var allowedParams = ["locale", "source", "status"];
            if (!allowedEvents.includes(eventName) || typeof window.gtag !== "function") return;
            var clean = {};
            Object.entries(params || {}).forEach(function(entry) {
              if (allowedParams.includes(entry[0]) && typeof entry[1] === "string" && entry[1].length <= 80) clean[entry[0]] = entry[1];
            });
            window.gtag("event", eventName, clean);
          }
        };
      </script>
    <% end %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
