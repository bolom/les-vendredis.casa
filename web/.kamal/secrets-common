# .kamal/secrets-common
# Kamal values needed before the Rails container starts.
# Values are fetched from the 1Password vault `lesvendredis.casa`.
# Do not put raw credentials in this file.

KAMAL_INFOMANIAK_HOST=185.143.102.224
KAMAL_1PASSWORD_ACCOUNT=${KAMAL_1PASSWORD_ACCOUNT:?Set KAMAL_1PASSWORD_ACCOUNT to your 1Password account identifier}

COMMON_SECRETS=$(kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/common KAMAL_REGISTRY_PASSWORD)

KAMAL_REGISTRY_PASSWORD=$(kamal secrets extract KAMAL_REGISTRY_PASSWORD $COMMON_SECRETS)

COMMON_SECRETS=
