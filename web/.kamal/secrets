# PRODUCTION
# Values are fetched from the 1Password vault `lesvendredis.casa`, item `production`.
# Do not put raw credentials in this file.

SECRETS=$(kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/production DATABASE_URL RESEND_API_KEY SECRET_KEY_BASE)

DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
RESEND_API_KEY=$(kamal secrets extract RESEND_API_KEY $SECRETS)
SECRET_KEY_BASE=$(kamal secrets extract SECRET_KEY_BASE $SECRETS)

SECRETS=
