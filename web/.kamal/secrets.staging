# STAGING
# Values are fetched from the 1Password vault `lesvendredis.casa`, item `staging`.
# Do not put raw credentials in this file.

SECRETS=$(kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/staging DATABASE_URL RAILS_MASTER_KEY)

DATABASE_URL=$(kamal secrets extract DATABASE_URL $SECRETS)
RAILS_MASTER_KEY=$(kamal secrets extract RAILS_MASTER_KEY $SECRETS)

SECRETS=
