#!/usr/bin/env bash
set -euo pipefail

backup_dir="${LES_VENDREDIS_BACKUP_DIR:-/var/backups/les-vendredis}"
retention_days="${LES_VENDREDIS_BACKUP_RETENTION_DAYS:-14}"
database_container="${LES_VENDREDIS_DB_CONTAINER:-les-vendredis-db}"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
destination="${backup_dir}/les-vendredis-${timestamp}.dump"
temporary="${destination}.partial"

install -d -m 0700 "${backup_dir}"
trap 'rm -f "${temporary}"' EXIT

docker exec "${database_container}" pg_dump \
  --username les_vendredis \
  --dbname les_vendredis \
  --format custom \
  --compress 9 > "${temporary}"

test -s "${temporary}"
mv "${temporary}" "${destination}"
chmod 0600 "${destination}"
find "${backup_dir}" -type f -name 'les-vendredis-*.dump' -mtime "+${retention_days}" -delete

echo "PostgreSQL backup created: ${destination}"
