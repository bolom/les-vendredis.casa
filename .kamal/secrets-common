# Kamal values needed before the Rails container starts.
# Fetched from the 1Password vault `lesvendredis.casa`, item `common`.
# Do not put raw credentials in this file.
# The fetch|parse pipeline runs in a real shell (sh -c); only the account id
# is expanded by dotenv itself.

KAMAL_REGISTRY_PASSWORD=$(sh -c 'kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/common KAMAL_REGISTRY_PASSWORD | ruby -rjson -e "puts JSON.parse(STDIN.read).values.first"')
