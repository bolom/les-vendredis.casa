# PRODUCTION
# Values are fetched from the 1Password vault `lesvendredis.casa`, item `production`.
# CI injects them as environment variables instead; 1Password remains the
# local fallback. Do not put raw credentials in this file.

RAILS_MASTER_KEY=$(if [ -n "\$RAILS_MASTER_KEY" ]; then echo "\$RAILS_MASTER_KEY"; else kamal secrets fetch --adapter 1password --account O7WN5QZY5RFHHHRPVDDWZ5FJZQ --from lesvendredis.casa/production RAILS_MASTER_KEY | ruby -rjson -e "puts JSON.parse(STDIN.read).values.first"; fi)

POSTGRES_PASSWORD=$(if [ -n "\$POSTGRES_PASSWORD" ]; then echo "\$POSTGRES_PASSWORD"; else kamal secrets fetch --adapter 1password --account O7WN5QZY5RFHHHRPVDDWZ5FJZQ --from lesvendredis.casa/production POSTGRES_PASSWORD | ruby -rjson -e "puts JSON.parse(STDIN.read).values.first"; fi)

DATABASE_URL=$(if [ -n "\$DATABASE_URL" ]; then echo "\$DATABASE_URL"; else echo "postgres://les_vendredis:$POSTGRES_PASSWORD@172.17.0.1:5433/les_vendredis"; fi)
