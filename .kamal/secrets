# PRODUCTION
# Values are fetched from the 1Password vault `lesvendredis.casa`, item `production`.
# Do not put raw credentials in this file.
# The fetch|parse pipeline runs in a real shell (sh -c); only the account id
# is expanded by dotenv itself.

RAILS_MASTER_KEY=$(sh -c 'kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/production RAILS_MASTER_KEY | ruby -rjson -e "puts JSON.parse(STDIN.read).values.first"')

POSTGRES_PASSWORD=$(sh -c 'kamal secrets fetch --adapter 1password --account $KAMAL_1PASSWORD_ACCOUNT --from lesvendredis.casa/production POSTGRES_PASSWORD | ruby -rjson -e "puts JSON.parse(STDIN.read).values.first"')

DATABASE_URL=$(sh -c 'echo "postgres://les_vendredis:$POSTGRES_PASSWORD@172.17.0.1:5433/les_vendredis"')
