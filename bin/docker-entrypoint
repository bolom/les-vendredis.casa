#!/bin/bash -e

# Prepare the primary database and the Solid stores (queue/cache/cable).
# db:prepare alone can skip the Solid schemas when primary already exists
# in the shared Postgres database (refs #33). The task is idempotent, so
# it is safe for every role (web server, jobs worker, one-off consoles).
./bin/rails db:prepare db:solid_stores

exec "${@}"
