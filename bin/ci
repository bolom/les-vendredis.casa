#!/usr/bin/env bash
set -euo pipefail

echo "== Setup =="
bin/setup --skip-server

echo "== Ruby style =="
bin/rubocop

echo "== Gem audit =="
bin/bundler-audit

echo "== Brakeman =="
# EOLRails excluded here too (see bin/brakeman) until the Rails 8.1 upgrade
# tracked in issue #41 removes the need.
bin/brakeman --quiet --no-pager --exit-on-warn --exit-on-error -x EOLRails

echo "== Tests =="
bin/rails test

echo "== Assets =="
DATABASE_URL="${DATABASE_URL:-postgres://localhost/les_vendredis_test}" RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bin/rails assets:precompile
