#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# EOLRails is skipped deliberately: Rails 8.0 reaches end-of-support on
# 2026-11-07 and the warning flips on at the 60-day mark depending on the
# runner's local date (it broke CI at midnight UTC on 2026-09-08). Upgrading
# to Rails 8.1 (needs Ruby >= 3.4) is tracked in issue #41 — remove this
# exclusion when the upgrade lands.
ARGV.unshift("--ensure-latest")
ARGV.unshift("-x", "EOLRails")

load Gem.bin_path("brakeman", "brakeman")
