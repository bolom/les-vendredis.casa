<h1><%= @user.persisted? ? "Modifier l’utilisateur" : "Nouvel utilisateur" %></h1>

<%= form_with model: [:admin, @user], url: @user.persisted? ? admin_user_path(@user) : admin_users_path, class: "admin-form" do |form| %>
  <% if @user.errors.any? %>
    <p role="alert"><%= @user.errors.full_messages.to_sentence %></p>
  <% end %>

  <div>
    <%= form.label :email_address, "Adresse email" %>
    <%= form.email_field :email_address, required: true, autocomplete: "off" %>
  </div>

  <% if @user.persisted? && @user == Current.user %>
    <div>
      <span class="admin-definition">Accès technique : <%= @user.technical_access? ? "actif" : "inactif" %> (non modifiable sur votre propre compte)</span>
    </div>
  <% else %>
    <div>
      <%= form.check_box :technical_access %>
      <%= form.label :technical_access, "Accès à la zone technique (paiements, utilisateurs, diagnostics)", class: "admin-inline" %>
    </div>
  <% end %>

  <div>
    <%= form.label :password, @user.persisted? ? "Nouveau mot de passe (laisser vide pour conserver)" : "Mot de passe" %>
    <%= form.password_field :password, required: !@user.persisted?, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div>
    <%= form.label :password_confirmation, "Confirmation du mot de passe" %>
    <%= form.password_field :password_confirmation, required: !@user.persisted?, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div><%= form.submit "Enregistrer" %></div>
<% end %>

<p><%= link_to "← Tous les utilisateurs", admin_users_path, class: "admin-button admin-button--secondary" %></p>
