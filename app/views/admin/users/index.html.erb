<h1>Utilisateurs</h1>
<p class="admin-definition">Comptes qui peuvent se connecter à l'administration. L'accès technique ouvre les paiements, les utilisateurs et les diagnostics.</p>
<p><%= link_to "Nouvel utilisateur", new_admin_user_path, class: "admin-button" %></p>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Email</th>
        <th scope="col">Créé le</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td>
            <%= user.email_address %><%= " (vous)" if user == Current.user %>
            <br>
            <span class="admin-definition">Accès technique : <%= user.technical_access? ? "actif" : "inactif" %></span>
          </td>
          <td><%= l(user.created_at, format: :long) %></td>
          <td>
            <%= link_to "Modifier", edit_admin_user_path(user) %>
            ·
            <%= button_to "Supprimer", admin_user_path(user), method: :delete, class: "admin-button--danger", data: { lv_confirm: "Supprimer définitivement l’utilisateur #{user.email_address} ? Ses sessions seront révoquées." } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
