<h1>Demandes de réservation</h1>

<%= form_with url: admin_booking_inquiries_path, method: :get, class: "admin-filters" do %>
  <%= label_tag :status, "Statut" %>
  <%= select_tag :status, options_for_select([["Tous", ""]] + BookingInquiry.statuses.keys.map { |status| [status, status] }, params[:status]) %>
  <%= label_tag :q, "Recherche" %>
  <%= search_field_tag :q, params[:q], placeholder: "Référence, nom ou email" %>
  <%= submit_tag "Filtrer" %>
<% end %>

<%= render "table", booking_inquiries: @booking_inquiries %>
