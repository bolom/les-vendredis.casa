<table class="admin-table">
  <thead>
    <tr>
      <th scope="col">Référence</th>
      <th scope="col">Dates</th>
      <th scope="col">Voyageur</th>
      <th scope="col">Personnes</th>
      <th scope="col">Statut</th>
      <th scope="col">Reçue le</th>
    </tr>
  </thead>
  <tbody>
    <% booking_inquiries.each do |booking_inquiry| %>
      <tr>
        <td><%= link_to booking_inquiry.public_reference, admin_booking_inquiry_path(booking_inquiry) %></td>
        <td><%= l(booking_inquiry.check_in) %> → <%= l(booking_inquiry.check_out) %></td>
        <td><%= booking_inquiry.guest_name %><br><span class="admin-definition"><%= booking_inquiry.email %></span></td>
        <td><%= booking_inquiry.adults %> adulte(s), <%= booking_inquiry.children %> enfant(s)</td>
        <td><%= booking_inquiry.status %></td>
        <td><%= l(booking_inquiry.created_at, format: :short) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
