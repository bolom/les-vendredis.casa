<% managed = availability_block.direct_stay? && availability_block.persisted? %>
<%= form_with model: [:admin, availability_block], class: "admin-form" do |form| %>
  <% if availability_block.errors.any? %>
    <p role="alert"><%= availability_block.errors.full_messages.to_sentence %></p>
  <% end %>

  <% if managed %>
    <p class="admin-definition">Ce séjour est géré par sa réservation : statut et dates se changent via les actions de la demande (acceptation, rapprochement de paiement), pas via ce formulaire.</p>
  <% end %>

  <div>
    <%= form.label :starts_on, "Début" %>
    <%= form.date_field :starts_on, required: true, disabled: managed %>
  </div>

  <div>
    <%= form.label :ends_on, "Fin" %>
    <%= form.date_field :ends_on, required: true, disabled: managed %>
  </div>

  <div>
    <%= form.label :status, "Statut" %>
    <%= form.select :status, [["Confirmé", "confirmed"], ["Provisoire", "tentative"], ["Annulé", "cancelled"]], {}, disabled: managed %>
  </div>

  <div>
    <%= form.label :summary, "Libellé" %>
    <%= form.text_field :summary, placeholder: "Ex. : maintenance, réservation extérieure…" %>
  </div>

  <div>
    <%= form.label :note, "Note interne" %>
    <%= form.text_area :note, rows: 4 %>
  </div>

  <div><%= form.submit "Enregistrer" %></div>
<% end %>
