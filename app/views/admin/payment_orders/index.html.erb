<h1>Paiements</h1>
<p class="admin-definition">Consultation et rapprochement manuel uniquement — aucun paiement ni remboursement n’est déclenché depuis l’admin.</p>

<%= form_with url: admin_payment_orders_path, method: :get, class: "admin-filters" do %>
  <%= label_tag :status, "Statut" %>
  <%= select_tag :status, options_for_select([["Tous", ""], ["À rapprocher", "pending"]] + (Admin::PaymentOrdersController::FILTERABLE_STATUSES - %w[pending]).map { |status| [status, status] }, params[:status]) %>
  <%= submit_tag "Filtrer" %>
<% end %>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Référence</th>
        <th scope="col">Statut</th>
        <th scope="col">Montant</th>
        <th scope="col">Créé le</th>
        <th scope="col">Expire le</th>
      </tr>
    </thead>
    <tbody>
      <% @payment_orders.each do |payment_order| %>
        <tr>
          <td><%= link_to payment_order.public_id, admin_payment_order_path(payment_order) %></td>
          <td><%= human_payment_status(payment_order.status) %></td>
          <td><%= payment_order.requirements["amount"] %> unités</td>
          <td><%= l(payment_order.created_at, format: :long) %></td>
          <td><%= l(payment_order.expires_at, format: :long) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
