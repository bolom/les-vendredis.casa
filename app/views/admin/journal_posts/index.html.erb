<h1>Journal</h1>
<p class="admin-definition">Articles publiés sur le site public. Un article daté dans le futur reste invisible jusqu'à sa date.</p>
<p><%= link_to "Nouvel article", new_admin_journal_post_path, class: "admin-button" %></p>

<%= form_with url: admin_journal_posts_path, method: :get, class: "admin-filters" do %>
  <%= label_tag :locale, "Langue" %>
  <%= select_tag :locale, options_for_select([["Toutes", ""], ["Français", "fr"], ["English", "en"]], params[:locale]) %>
  <%= label_tag :status, "Statut" %>
  <%= select_tag :status, options_for_select([["Tous", ""], ["Publié", "published"], ["Brouillon", "draft"]], params[:status]) %>
  <%= label_tag :q, "Recherche" %>
  <%= search_field_tag :q, params[:q], placeholder: "Titre ou slug" %>
  <%= submit_tag "Filtrer" %>
<% end %>

<div class="admin-table-wrap">
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Titre</th>
        <th scope="col">Langue</th>
        <th scope="col">Catégorie</th>
        <th scope="col">Statut</th>
        <th scope="col">Date de publication</th>
      </tr>
    </thead>
    <tbody>
      <% @journal_posts.each do |post| %>
        <tr>
          <td><%= link_to post.title, edit_admin_journal_post_path(post.id) %></td>
          <td><%= post.locale.upcase %></td>
          <td><%= post.tag.presence || "—" %></td>
          <td><%= post.published? ? "Publié" : "Brouillon" %></td>
          <td><%= l(post.published_on) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
