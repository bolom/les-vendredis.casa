<h1><%= @content_page.persisted? ? "Modifier la page" : "Nouvelle page de contenu" %></h1>

<%= form_with model: @content_page, url: @content_page.persisted? ? admin_content_page_path(@content_page.id) : admin_content_pages_path, class: "admin-form" do |form| %>
  <% if @content_page.errors.any? %>
    <p role="alert"><%= @content_page.errors.full_messages.to_sentence %></p>
  <% end %>

  <div>
    <%= form.label :path, "Chemin (ex. : roches-gravees-sainte-luce ou fr/guide)" %>
    <%= form.text_field :path, required: true, pattern: "[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*" %>
  </div>

  <div>
    <%= form.label :locale, "Langue" %>
    <%= form.select :locale, [["Français", "fr"], ["English", "en"]] %>
  </div>

  <div>
    <%= form.label :title, "Titre" %>
    <%= form.text_field :title, required: true %>
  </div>

  <div>
    <%= form.label :description, "Description (meta)" %>
    <%= form.text_area :description, rows: 2 %>
  </div>

  <div>
    <%= form.label :body_html, "Contenu (HTML)" %>
    <%= form.text_area :body_html, rows: 20, required: true %>
  </div>

  <div>
    <%= form.label :canonical_url, "URL canonique" %>
    <%= form.url_field :canonical_url %>
  </div>

  <div>
    <%= form.label :robots, "Robots (meta)" %>
    <%= form.text_field :robots, placeholder: "index, follow" %>
  </div>

  <div>
    <%= form.label :alternate_en_url, "URL alternative EN" %>
    <%= form.url_field :alternate_en_url %>
  </div>

  <div>
    <%= form.label :alternate_fr_url, "URL alternative FR" %>
    <%= form.url_field :alternate_fr_url %>
  </div>

  <div>
    <%= form.label :structured_data, "Données structurées (JSON ou tableau JSON)" %>
    <%= form.text_area :structured_data, rows: 6 %>
  </div>

  <div>
    <%= form.check_box :published %>
    <%= form.label :published, "Publiée (visible sur le site public)", class: "admin-inline" %>
  </div>

  <div><%= form.submit "Enregistrer" %></div>
<% end %>

<% if @content_page.persisted? %>
  <p><%= link_to "← Toutes les pages", admin_content_pages_path, class: "admin-button admin-button--secondary" %></p>
<% end %>
