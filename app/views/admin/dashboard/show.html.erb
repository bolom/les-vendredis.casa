<h1>Tableau de bord</h1>

<div class="admin-counters">
  <div class="admin-counter">
    <strong><%= @new_inquiries_count %></strong>
    nouvelles demandes de réservation
    <%= link_to "Voir", admin_booking_inquiries_path(status: "new") %>
  </div>
  <div class="admin-counter">
    <strong><%= @payments_review_count %></strong>
    paiements à rapprocher
    <%= link_to "Voir", admin_payment_orders_path(status: "pending") %>
  </div>
  <div class="admin-counter">
    <strong><%= @failed_notifications_count %></strong>
    notifications en échec
    <%= link_to "Voir", admin_root_path(anchor: "notifications-en-echec") %>
  </div>
  <div class="admin-counter">
    <strong><%= @draft_posts_count %></strong>
    articles du journal en brouillon
    <%= link_to "Voir", admin_journal_posts_path %>
  </div>
</div>

<h2>Dernières demandes de réservation</h2>
<%= render "admin/booking_inquiries/table", booking_inquiries: @recent_inquiries %>

<h2>Paiements en attente de rapprochement</h2>
<% if @pending_payment_orders.any? %>
  <ul>
    <% @pending_payment_orders.each do |order| %>
      <li><%= link_to order.public_id, admin_payment_order_path(order) %> — <%= order.status %></li>
    <% end %>
  </ul>
<% else %>
  <p class="admin-definition">Aucun paiement en attente de rapprochement.</p>
<% end %>

<h2 id="notifications-en-echec">Notifications en échec</h2>
<% if @failed_notifications.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th scope="col">Réservation</th>
        <th scope="col">Événement</th>
        <th scope="col">Essais</th>
        <th scope="col">Dernière erreur</th>
      </tr>
    </thead>
    <tbody>
      <% @failed_notifications.each do |notification| %>
        <tr>
          <td><%= link_to notification.booking_inquiry.public_reference, admin_booking_inquiry_path(notification.booking_inquiry) %></td>
          <td><%= notification.event %></td>
          <td><%= notification.attempts %></td>
          <td><%= notification.last_error %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="admin-definition">Aucune notification en échec.</p>
<% end %>
