<main>
  <h1>Admin Les Vendredis</h1>
  <nav>
    <%= link_to "Journal", admin_journal_posts_path %>
    <%= link_to "Booking inquiries", admin_booking_inquiries_path %>
    <%= link_to "Availability blocks", admin_availability_blocks_path %>
    <%= link_to "Stay rules", edit_admin_stay_rule_path %>
    <%= link_to "Calendar imports", admin_calendar_imports_path %>
  </nav>
  <h2>Paiements à vérifier</h2>
  <% @payment_reviews.each do |order| %>
    <p><%= order.public_id %> — <%= order.status %> — <%= order.requirements["amount"] %> unités — <%= link_to "Réservation", admin_booking_inquiry_path(order.booking_inquiry) if order.booking_inquiry %></p>
    <%= form_with url: admin_payment_order_path(order), method: :patch do %>
      <p>Enregistrer uniquement un résultat déjà vérifié chez le prestataire ou sur la blockchain. Cette action n’envoie aucun paiement ni remboursement.</p>
      <%= select_tag :outcome, options_for_select([["Paiement confirmé", "confirmed"], ["Remboursement effectué", "refunded"], ["Aucun transfert effectué", "no_transfer"]]) %>
      <%= text_area_tag :evidence, nil, required: true, minlength: 20, maxlength: 2000, placeholder: "Référence de transaction / prestataire et vérifications effectuées", aria: { label: "Preuve de rapprochement" } %>
      <label><%= check_box_tag :review_confirmed, "1", false, required: true %> J’ai vérifié le résultat et ses justificatifs.</label>
      <%= submit_tag "Enregistrer le rapprochement" %>
    <% end %>
  <% end %>
  <h2>Notifications en attente après erreur</h2>
  <% @notification_failures.each do |notification| %>
    <p><%= notification.event %> — <%= notification.attempts %> essais — <%= notification.last_error %> — <%= link_to "Réservation", admin_booking_inquiry_path(notification.booking_inquiry) %></p>
  <% end %>
</main>
