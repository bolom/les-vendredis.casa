<% bi = @booking_inquiry
   fr = bi.locale == "fr" %>
<%
  checkin_label  = fr ? "Arrivée" : "Check-in"
  checkout_label = fr ? "Départ" : "Check-out"
  nights_label   = fr ? "Durée" : "Length"
  guests_label   = fr ? "Voyageurs" : "Guests"
  ref_label      = fr ? "Référence" : "Reference"
  price_label    = fr ? "Prix total" : "Total price"
  row_style = "border-bottom:1px solid #E3D9C6;"
  guests_value =
    if fr
      base = "#{bi.adults} adulte#{'s' if bi.adults > 1}"
      bi.children.positive? ? "#{base}, #{bi.children} enfant#{'s' if bi.children > 1}" : base
    else
      base = "#{bi.adults} adult#{'s' if bi.adults > 1}"
      bi.children.positive? ? "#{base}, #{bi.children} child#{'ren' if bi.children > 1}" : base
    end
%>

<p style="margin:0 0 10px 0; font-family:Georgia,'Times New Roman',Times,serif; font-size:27px; font-weight:normal; color:#1F1611;">
  <% if fr %>
    Votre séjour est confirmé, <%= bi.guest_name %>
  <% else %>
    Your stay is confirmed, <%= bi.guest_name %>
  <% end %>
</p>
<p style="margin:0 0 28px 0; font-family:Helvetica,Arial,sans-serif; font-size:15px; line-height:1.65; color:#4A3A2D;">
  <% if fr %>
    Nous avons le plaisir de vous accueillir. Voici tout ce qu'il faut savoir — gardez cet email, il contient votre référence.
  <% else %>
    We are delighted to welcome you. Here is everything you need to know — keep this email, it contains your reference.
  <% end %>
</p>

<%# Récap card %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#F2EAD9; border-top:2px solid #B08A4D; margin-bottom:28px;">
  <tr><td style="padding:22px 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= checkin_label %></td>
          <td align="right" style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1F1611;"><%= l(bi.check_in, format: "%-d %B %Y") %></td></tr>
      <tr><td style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= checkout_label %></td>
          <td align="right" style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1F1611;"><%= l(bi.check_out, format: "%-d %B %Y") %></td></tr>
      <tr><td style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= nights_label %></td>
          <td align="right" style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1F1611;"><%= bi.nights %> <%= fr ? "nuit#{'s' if bi.nights > 1}" : "night#{'s' if bi.nights > 1}" %></td></tr>
      <tr><td style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= guests_label %></td>
          <td align="right" style="padding:8px 0; <%= row_style %>font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1F1611;"><%= guests_value %></td></tr>
      <tr><td style="padding:8px 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= ref_label %></td>
          <td align="right" style="padding:8px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; color:#1F1611;"><%= bi.public_reference %></td></tr>
      <% if @price.present? %>
      <tr><td style="padding:10px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:13px; color:#8C7B66;"><%= price_label %></td>
          <td align="right" style="padding:10px 0 0 0; font-family:Helvetica,Arial,sans-serif; font-size:16px; color:#B85F38;">
            <%= @price.round %> € <%= fr ? "au total" : "total" %><%= " (#{@nightly_price.round} € #{fr ? 'la nuit' : 'per night'})" if @nightly_price.present? %>
          </td></tr>
      <% end %>
    </table>
  </td></tr>
</table>

<%# Section localisation %>
<p style="margin:26px 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:3px; color:#8C7B66;"><%= fr ? "OÙ NOUS TROUVER" : "FINDING US" %></p>
<p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  Les Vendredis<br>Quartier Montravail, route de Zaire<br>Sainte-Luce, Martinique
</p>
<p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  <% if fr %>
    La cabane est à 250 m d'altitude, dans la forêt. Les plages de Sainte-Luce sont à 5 minutes en voiture. Une voiture est fortement recommandée.
  <% else %>
    The cabin sits at 250 m altitude, surrounded by forest. The beaches of Sainte-Luce are a 5-minute drive away. A car is strongly recommended.
  <% end %>
</p>

<%# Section arrivée/départ %>
<p style="margin:26px 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:3px; color:#8C7B66;"><%= fr ? "ARRIVÉE ET DÉPART" : "ARRIVAL AND DEPARTURE" %></p>
<p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  <% if fr %>
    Pas de boîte à clés ni de code : nous vous accueillons nous-mêmes ou organisons un contact humain. Prévenez-nous de votre heure d'arrivée.
  <% else %>
    No lockbox, no code: we welcome you ourselves or arrange a human handover. Let us know your arrival time.
  <% end %>
</p>

<%# Section bon à savoir %>
<p style="margin:26px 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:3px; color:#8C7B66;"><%= fr ? "BON À SAVOIR" : "GOOD TO KNOW" %></p>
<ul style="margin:0 0 10px 0; padding-left:18px; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  <% if fr %>
    <li>Pas de climatisation, pas de télévision, WiFi limité : le lieu est pensé pour déconnecter. Les alizés rafraîchissent la cabane la nuit.</li>
    <li>Votre animal est le bienvenu.</li>
    <li>Le jardin privatif fait 600 m².</li>
  <% else %>
    <li>No air conditioning, no TV, limited WiFi: the place is meant for disconnecting. Trade winds cool the cabin at night.</li>
    <li>Your pet is welcome.</li>
    <li>The private garden is 600 m².</li>
  <% end %>
</ul>

<%# Section paiement %>
<% if @price.present? %>
<% pay_section_label = fr ? "PAIEMENT" : "PAYMENT" %>
<p style="margin:26px 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:10px; letter-spacing:3px; color:#8C7B66;"><%= pay_section_label %></p>
<p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  <% if fr %>
    Montant à régler : <strong><%= payment_amount_eur.round %> €<%= " (#{payment_nightly_price_eur.round} € la nuit)" if payment_nightly_price_eur.present? %></strong>, par virement bancaire, à recevoir au plus tard le <%= payment_due_date_l %>.
  <% else %>
    Amount due: <strong>€<%= payment_amount_eur.round %><%= " (€#{payment_nightly_price_eur.round} per night)" if payment_nightly_price_eur.present? %></strong>, by bank transfer, to be received no later than <%= payment_due_date_l %>.
  <% end %>
</p>
<% if payment_bank_details.present? %>
<p style="margin:0 0 10px 0; font-family:Helvetica,Arial,sans-serif; font-size:14px; line-height:1.7; color:#4A3A2D;">
  <%= fr ? "Coordonnées bancaires :" : "Bank details:" %><br>
  <span style="font-family:Menlo,Consolas,monospace; font-size:13px;"><%= payment_bank_details %></span>
</p>
<% end %>
<% end %>

<%# CTA et note %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:30px 0 8px 0;">
  <tr>
    <td align="center" bgcolor="#B85F38" style="padding:14px 34px;">
      <a href="<%= @confirmation_url %>" style="display:inline-block; font-family:Helvetica,Arial,sans-serif; font-size:13px; letter-spacing:2px; text-transform:uppercase; text-decoration:none; color:#F8F1E4;"><%= fr ? "Votre réservation" : "Your booking" %></a>
    </td>
  </tr>
</table>
<p style="margin:0 0 30px 0; text-align:center; font-family:Helvetica,Arial,sans-serif; font-size:12px; line-height:1.6; color:#8C7B66;">
  <%= fr ? "Une question ? Répondez simplement à cet email, ou écrivez à hello@lesvendredis.casa" : "Any question? Just reply to this email, or write to hello@lesvendredis.casa" %>
</p>
