<% french = @locale == :fr %>
<% content_for :title, french ? "Les Vendredis — Cabane A-frame en Martinique" : "Les Vendredis — A-frame cabin in Martinique" %>
<% content_for :head do %>
  <meta name="description" content="<%= french ? 'Cabane A-frame à Sainte-Luce, Martinique. Jardin tropical privé, journal du lieu, réservation directe et accueil humain.' : 'A-frame cabin in Sainte-Luce, Martinique. Private tropical garden, place journal, direct booking, and human hosting.' %>">
<% end %>

<main>
  <div class="wrap">
    <header class="hero-minimal">
      <div class="hero-minimal-text">
        <p class="hero-minimal-eyebrow">Sainte-Luce, Martinique</p>
        <% if french %>
          <h1 class="hero-minimal-h1">Les Vendredis, c’est la vraie vie<br>d’une famille autour <em>d’un domaine en Martinique.</em></h1>
          <p class="hero-minimal-sub">Le vendredi, Bolo écrit. Quand la maison est libre, vous pouvez venir dormir.</p>
          <div class="hero-minimal-ctas">
            <%= link_to "Voir le journal", french_journal_path, class: "hero-cta-primary" %>
            <%= link_to "Demander un séjour →", new_booking_inquiry_path, class: "hero-cta-secondary", data: { analytics_event: "start_inquiry" } %>
          </div>
        <% else %>
          <h1 class="hero-minimal-h1">Les Vendredis is the real life<br>of a family around <em>a domain in Martinique.</em></h1>
          <p class="hero-minimal-sub">On Fridays, Bolo writes. When the house is free, you can come stay.</p>
          <div class="hero-minimal-ctas">
            <%= link_to "Read the journal", journal_path, class: "hero-cta-primary" %>
            <%= link_to "Request a stay →", new_booking_inquiry_path, class: "hero-cta-secondary", data: { analytics_event: "start_inquiry" } %>
          </div>
        <% end %>
      </div>
      <div class="hero-minimal-photo">
        <%= image_tag "jpk-cabane-facade-plein-air.webp", alt: french ? "La cabane A-frame dans son jardin tropical" : "The A-frame cabin in its tropical garden", width: 1200, height: 1600, fetchpriority: "high" %>
      </div>
    </header>
  </div>

  <section class="home-journal" id="journal">
    <div class="wrap">
      <div class="home-journal-header">
        <span class="home-journal-label">Journal</span>
      </div>

      <% featured = @home_journal_posts.first %>
      <% if featured %>
        <%= link_to(french ? french_journal_post_path(featured.slug) : journal_post_path(featured.slug), class: "home-journal-featured") do %>
          <div class="home-journal-featured-img">
            <%= image_tag(featured.public_image_path.presence || "jpk-cabane-facade-plein-air.webp", alt: featured.image_alt.presence || featured.title, loading: "eager") %>
          </div>
          <div class="home-journal-featured-body">
            <span class="home-journal-date"><%= l(featured.published_on, format: :long) %></span>
            <h2 class="home-journal-title"><%= featured.title %></h2>
            <% if featured.summary.present? %><p class="home-journal-summary"><%= featured.summary %></p><% end %>
            <span class="home-journal-read"><%= french ? "Lire →" : "Read →" %></span>
          </div>
        <% end %>
      <% end %>

      <% if @home_journal_posts.size > 1 %>
        <ul class="home-journal-secondary">
          <% @home_journal_posts.drop(1).each do |post| %>
            <li>
              <%= link_to(french ? french_journal_post_path(post.slug) : journal_post_path(post.slug)) do %>
                <span class="home-journal-secondary-date"><%= l(post.published_on, format: :long) %></span>
                <span class="home-journal-secondary-title"><%= post.title %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <div class="home-journal-foot">
        <%= link_to(french ? "Tous les articles →" : "All entries →", french ? french_journal_path : journal_path) %>
      </div>
    </div>
  </section>

  <section class="newsletter-section">
    <div class="wrap">
      <div class="newsletter-inner">
        <div class="newsletter-text">
          <p class="newsletter-label"><%= french ? "Une lettre, de temps en temps." : "A letter, now and then." %></p>
          <p class="newsletter-sub"><%= french ? "Ce qui pousse, ce qu'on construit, ce qui change." : "What grows, what we build, what changes." %></p>
        </div>
        <form class="newsletter-form" action="https://buttondown.com/api/emails/embed-subscribe/lesvendredis" method="post">
          <div class="newsletter-row">
            <input type="email" name="email" placeholder="<%= french ? 'votre@email.com' : 'your@email.com' %>" required aria-label="<%= french ? 'votre@email.com' : 'your@email.com' %>">
            <button type="submit"><%= french ? "S'inscrire" : "Subscribe" %></button>
          </div>
          <input type="hidden" name="tag" value="<%= @locale %>">
        </form>
      </div>
    </div>
  </section>

  <section class="come-stay" id="stay">
    <div class="wrap come-stay-inner">
      <div class="come-stay-text">
        <h2 class="come-stay-h2"><%= french ? "Venez dormir." : "Come stay." %></h2>
        <p class="come-stay-lead"><%= french ? "Choisissez vos dates et écrivez-nous. Nous vérifions le calendrier, échangeons avec vous et confirmons simplement." : "Choose your dates and write to us. We check the calendar, talk with you, and confirm simply." %></p>
        <%= link_to(french ? "Faire une demande →" : "Send a request →", new_booking_inquiry_path, class: "come-stay-email") %>
        <p class="come-stay-alt">
          <%= french ? "Aussi sur" : "Also on" %>
          <a href="https://airbnb.fr/h/lesvendredis" target="_blank" rel="noopener">Airbnb</a>
          <%= french ? "et" : "and" %>
          <a href="https://www.booking.com/hotel/mq/les-vendredis.html" target="_blank" rel="noopener">Booking</a>.
        </p>
      </div>
      <div class="come-stay-calendar">
        <p class="hero-minimal-eyebrow"><%= french ? "Réservation directe" : "Direct booking" %></p>
        <div id="availability-cal" class="availability-cal" data-availability-url="/availability" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <section class="gallery-section" id="gallery">
    <div class="wrap">
      <div class="section-head section-head-min">
        <h2>Fragments.</h2>
      </div>

      <div class="domain-tour">
        <% @home_gallery_sections.each do |section| %>
          <section class="domain-area">
            <div class="domain-area-copy">
              <span class="domain-area-num"><%= section[:number] %></span>
              <h3><%= section[:title] %></h3>
              <p><%= section[:copy] %></p>
            </div>
            <div class="domain-area-gallery">
              <% section[:items].each do |item| %>
                <div class="gallery-item <%= item[:css_class] %>" onclick="openLightbox(<%= item[:index] %>)">
                  <%= image_tag item[:src], alt: item[:alt], loading: "lazy" %>
                  <div class="gallery-caption"><span><%= item[:caption] %></span></div>
                </div>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>
    </div>
  </section>

  <section class="faq-section">
    <div class="wrap">
      <div class="section-head section-head-min">
        <h2><%= french ? "FAQ" : "FAQ" %></h2>
      </div>
      <div class="faq-list">
        <% @home_faqs.each do |faq| %>
          <div class="faq-item">
            <h3><%= faq[:question] %></h3>
            <p><%= faq[:answer] %></p>
          </div>
        <% end %>
      </div>
      <div class="home-journal-foot">
        <%= link_to(french ? "En savoir plus sur le séjour →" : "Learn more about the stay →", french ? content_page_path("fr/hebergement-atypique-martinique") : content_page_path("unique-stay-martinique")) %>
      </div>
    </div>
  </section>
</main>
